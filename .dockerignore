# Ignorer les fichiers et dossiers Python générés
__pycache__/
*.pyc
*.pyo
*.pyd

# Ignorer les environnements virtuels
venv/
env/
*.venv
.env

# Ignorer les fichiers système inutiles
.DS_Store
Thumbs.db

# Ignorer les fichiers liés à Git et les logs
.git
.gitignore
*.log

# Ignorer les archives et fichiers temporaires
*.tar
*.zip
*.gz
